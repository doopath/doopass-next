<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Doopass.Cli</RootNamespace>
    <AssemblyName>doopass</AssemblyName>
    <Version>5.0.0</Version>
    <UseAppHost>true</UseAppHost>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- blazor.web.js ships in Microsoft.AspNetCore.App.Internal.Assets, but restore
         only pulls that package for projects that opt into framework web assets
         (i.e. ones with .razor content). This host serves blazor.web.js from it, so
         ask for it explicitly; otherwise the glob below matches nothing and the
         published binary 404s on /_framework/blazor.web.js. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Explorer / taskbar icon for the published doopass.exe; generated by
         scripts\generate-icons.py alongside the PWA icons. -->
    <ApplicationIcon>..\..\.pwa-assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Root UI assets (app.css / theme.js / app.js) live in Doopass.WebUi and are
         served from that assembly's embedded resources. PWA assets remain server
         assets of the host: the manifest, the service worker and icons are
         browser-only things, and blazor.web.js comes from the web host script. -->
    <_BlazorFrameworkAsset Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/*/_framework/blazor.web.js" />
    <EmbeddedResource Include="@(_BlazorFrameworkAsset)" LogicalName="Doopass.Cli.wwwroot.blazor.web.js" />

    <!-- PWA: manifest and sw.js live in wwwroot\pwa (text assets, embed normally);
         icons are generated by scripts\generate-icons.py into <repo>\.pwa-assets
         (see .gitignore) and embedded from there. The SVG favicon is the vector
         master straight from assets\, served as-is so it stays sharp at any size. -->
    <EmbeddedResource Include="wwwroot\pwa\manifest.webmanifest" LogicalName="Doopass.Cli.wwwroot.pwa.manifest.webmanifest" />
    <EmbeddedResource Include="wwwroot\pwa\sw.js" LogicalName="Doopass.Cli.wwwroot.pwa.sw.js" />
    <EmbeddedResource Include="..\..\assets\logo.svg" LogicalName="Doopass.Cli.wwwroot.pwa.favicon.svg" />
    <EmbeddedResource Include="..\..\.pwa-assets\favicon.ico" LogicalName="Doopass.Cli.wwwroot.pwa.favicon.ico" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-192.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-192.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-512.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-512.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-maskable-192.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-maskable-192.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-maskable-512.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-maskable-512.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\apple-touch-icon.png" LogicalName="Doopass.Cli.wwwroot.pwa.apple-touch-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't publish wwwroot as loose files; assets are embedded and served from resources. -->
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Doopass.Core\Doopass.Core.csproj" />
    <ProjectReference Include="..\Doopass.Tui\Doopass.Tui.csproj" />
    <ProjectReference Include="..\Doopass.WebUi\Doopass.WebUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Doopass.Api.Tests" />
  </ItemGroup>

  <!-- A missing framework asset used to be a silent 404 in the published app; fail
       the build instead. The version comes from the SDK, so it tracks the framework. -->
  <Target Name="_RequireBlazorWebJs" BeforeTargets="CoreCompile">
    <Error Condition="'@(_BlazorFrameworkAsset)' == ''"
           Text="blazor.web.js was not restored: Microsoft.AspNetCore.App.Internal.Assets is missing from $(NuGetPackageRoot). Run 'dotnet restore' and rebuild." />
  </Target>

</Project>
