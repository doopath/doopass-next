<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Doopass.Cli</RootNamespace>
    <AssemblyName>doopass</AssemblyName>
    <Version>5.0.0</Version>
    <UseAppHost>true</UseAppHost>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <!-- Explorer / taskbar icon for the published doopass.exe; generated by
          scripts\generate-icons.py alongside the PWA icons. -->
    <ApplicationIcon>..\..\.pwa-assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- PWA: manifest and sw.js live in wwwroot\pwa (text assets, embed normally);
          icons are generated by scripts\generate-icons.py into <repo>\.pwa-assets
          (see .gitignore) and embedded from there. The SVG favicon is the vector
          master straight from assets\, served as-is so it stays sharp at any size. -->
    <EmbeddedResource Include="wwwroot\pwa\manifest.webmanifest" LogicalName="Doopass.Cli.wwwroot.pwa.manifest.webmanifest" />
    <EmbeddedResource Include="wwwroot\pwa\sw.js" LogicalName="Doopass.Cli.wwwroot.pwa.sw.js" />
    <EmbeddedResource Include="..\..\assets\logo.svg" LogicalName="Doopass.Cli.wwwroot.pwa.favicon.svg" />
    <EmbeddedResource Include="..\..\.pwa-assets\favicon.ico" LogicalName="Doopass.Cli.wwwroot.pwa.favicon.ico" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-192.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-192.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-512.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-512.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-maskable-192.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-maskable-192.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-maskable-512.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-maskable-512.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\apple-touch-icon.png" LogicalName="Doopass.Cli.wwwroot.pwa.apple-touch-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Doopass.Core\Doopass.Core.csproj" />
    <ProjectReference Include="..\Doopass.Tui\Doopass.Tui.csproj" />
    <ProjectReference Include="..\Doopass.WebUi\Doopass.WebUi.csproj" />
    <!-- The client is referenced normally so its published output (index.html,
         _framework/*) flows to the host for UseBlazorFrameworkFiles(), and the
         RCL Doopass.WebUi assets flow as _content/* references. -->
    <ProjectReference Include="..\Doopass.WebClient\Doopass.WebClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Doopass.Api.Tests" />
  </ItemGroup>

  <!-- Keep the client's own build from inheriting the host's single-file globals. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <_GlobalPropertiesToRemoveFromProjectReferences>$(_GlobalPropertiesToRemoveFromProjectReferences);PublishSingleFile</_GlobalPropertiesToRemoveFromProjectReferences>
  </PropertyGroup>

  <!--
    The single-file host must not depend on a loose wwwroot/ directory next to the
    executable. Publish the Blazor client into an intermediate directory, zip its
    wwwroot into the host assembly as an embedded resource, and extract it to a
    per-version temp directory at startup. This keeps dev runs and folder publishes
    working too: the host simply serves the extracted bundle.
  -->
  <Target Name="PackWasmBundle" BeforeTargets="SplitResourcesByCulture;CreateManifestResourceNames"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_WasmPublishDir>$(MSBuildProjectDirectory)/obj/wasm-publish/$(Configuration)/</_WasmPublishDir>
      <_WasmZip>$(IntermediateOutputPath)doopass-wasm.zip</_WasmZip>
    </PropertyGroup>
    <RemoveDir Directories="$(_WasmPublishDir)" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/../Doopass.WebClient/Doopass.WebClient.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_WasmPublishDir);TargetFramework=net10.0"
             RemoveProperties="PublishSingleFile;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ZipDirectory SourceDirectory="$(_WasmPublishDir)wwwroot" DestinationFile="$(_WasmZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(_WasmZip)" LogicalName="Doopass.Cli.wwwroot.wasm.zip" />
    </ItemGroup>
  </Target>

  <!-- The UI is inside the embedded bundle for single-file builds, so the
       published wwwroot/ and static-web-asset manifest are redundant. Removing
       them keeps the portable output to one executable. -->
  <Target Name="TrimSingleFilePublishOutput" AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <Delete Files="$(PublishDir)doopass.staticwebassets.endpoints.json" />
  </Target>

</Project>
