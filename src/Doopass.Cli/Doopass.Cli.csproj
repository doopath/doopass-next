<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Doopass.Cli</RootNamespace>
    <AssemblyName>doopass</AssemblyName>
    <Version>5.0.0</Version>
    <UseAppHost>true</UseAppHost>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Root UI assets (app.css / theme.js / app.js) live in Doopass.WebUi and are
         served from that assembly's embedded resources. PWA assets remain server
         assets of the host: the manifest, the service worker and icons are
         browser-only things, and blazor.web.js comes from the web host script. -->
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/*/_framework/blazor.web.js"
                       LogicalName="Doopass.Cli.wwwroot.blazor.web.js" />

    <!-- PWA: manifest and sw.js live in wwwroot\pwa (text assets, embed normally);
         PNG icons are generated by scripts\generate-icons.py into <repo>\.pwa-assets
         (see .gitignore) and embedded from there. -->
    <EmbeddedResource Include="wwwroot\pwa\manifest.webmanifest" LogicalName="Doopass.Cli.wwwroot.pwa.manifest.webmanifest" />
    <EmbeddedResource Include="wwwroot\pwa\sw.js" LogicalName="Doopass.Cli.wwwroot.pwa.sw.js" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-192.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-192.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-512.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-512.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-maskable-192.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-maskable-192.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\icon-maskable-512.png" LogicalName="Doopass.Cli.wwwroot.pwa.icon-maskable-512.png" />
    <EmbeddedResource Include="..\..\.pwa-assets\apple-touch-icon.png" LogicalName="Doopass.Cli.wwwroot.pwa.apple-touch-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't publish wwwroot as loose files; assets are embedded and served from resources. -->
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Doopass.Core\Doopass.Core.csproj" />
    <ProjectReference Include="..\Doopass.Tui\Doopass.Tui.csproj" />
    <ProjectReference Include="..\Doopass.WebUi\Doopass.WebUi.csproj" />
  </ItemGroup>

</Project>
