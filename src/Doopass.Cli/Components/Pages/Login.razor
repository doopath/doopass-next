@page "/"
@layout AuthLayout
@inject DoopassSession Session
@inject NavigationManager Nav

<PageTitle>Doopass — Log in</PageTitle>

<h1 class="auth-title">Welcome back</h1>
<p class="auth-sub">Unlock your encrypted vault to continue.</p>

<div class="auth-form" @onkeydown="HandleKeyDown">
    <FluentTextInput @bind-Value="_password"
                     Type="TextInputType.Password"
                     Placeholder="Master password" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error">@_error</div>
    }

    <div class="auth-actions">
        <FluentButton Appearance="ButtonAppearance.Primary"
                      Class="grow"
                      OnClick="LogIn">Unlock vault</FluentButton>
        <FluentButton OnClick="@(() => Nav.NavigateTo("/init"))">Init store</FluentButton>
    </div>
</div>

<p class="auth-foot">Your data never leaves this machine.</p>

@code {
    private string? _password;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Session.IsUnlocked)
        {
            Nav.NavigateTo("/store");
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            LogIn();
        }
    }

    private void LogIn()
    {
        var (success, message) = Session.Login(_password ?? string.Empty);

        if (success)
        {
            _password = null;
            Nav.NavigateTo("/store");
            return;
        }

        if (!Session.StoreExists)
        {
            Nav.NavigateTo("/init");
            return;
        }

        _error = message;
    }
}
