@inject IJSRuntime JS

<button type="button" class="icon-btn" title="Toggle light / dark theme" @onclick="Toggle">
    <Icon Name="@(_isDark ? "sun" : "moon")" Size="18" />
</button>

@code {
    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _isDark = await JS.InvokeAsync<bool>("doopassTheme.isDark");
            StateHasChanged();
        }
        catch (JSException)
        {
            // theme.js is not available; fall back to the default theme.
        }
    }

    private async Task Toggle()
    {
        try
        {
            var mode = await JS.InvokeAsync<string>("doopassTheme.toggle");
            _isDark = mode == "dark";
        }
        catch (JSException)
        {
            // Ignore: theme switching is a progressive enhancement.
        }
    }
}
