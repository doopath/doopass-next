@inject IJSRuntime JS

<button type="button" class="icon-btn" title="Toggle light / dark theme" @onclick="Toggle">
    <Icon Name="@(_isDark ? "sun" : "moon")" Size="18" />
</button>

@code {
    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isDark = await JS.InvokeAsync<bool>("doopassTheme.isDark");
        StateHasChanged();
    }

    private async Task Toggle()
    {
        var mode = await JS.InvokeAsync<string>("doopassTheme.toggle");
        _isDark = mode == "dark";
    }
}
