<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Doopass.Tui</RootNamespace>
    <AssemblyName>Doopass.Tui</AssemblyName>
    <Version>5.0.0</Version>
    <!-- TextView is the built-in scrollable text pane; its replacement lives in an
         external package we deliberately do not depend on. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Doopass.Tui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Doopass.Core\Doopass.Core.csproj" />
  </ItemGroup>

</Project>
