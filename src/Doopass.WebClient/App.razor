@using System.Reflection

<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="@_additionalAssemblies"
        NotFoundPage="typeof(Doopass.WebUi.Components.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Doopass.WebUi.Components.Layout.MainLayout)" />
    </Found>
</Router>

@code {
    private static readonly Assembly[] _additionalAssemblies =
    {
        typeof(Doopass.WebUi.Components.App).Assembly,
    };
}
