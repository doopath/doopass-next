@inherits LayoutComponentBase

@* Same centred shell as AuthLayout: the picker is a single card, and matching
   the login screen keeps the transition between the two visually stable. *@
<div class="auth-shell auth-shell--connect">
    <div class="theme-corner">
        <ThemeToggle />
    </div>

    <div class="auth-card auth-card--connect">
        <div class="auth-brand">
            <div class="brand-mark brand-mark-lg">
                <img src="_content/Doopass.WebUi/brand.svg" alt="" width="52" height="52" />
            </div>
        </div>

        @Body
    </div>
</div>
