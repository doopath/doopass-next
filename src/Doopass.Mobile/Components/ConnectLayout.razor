@inherits LayoutComponentBase

@* AuthLayout with a top-aligned shell: the host list on /connect grows as
   discovery results appear, and a vertically centred card would jump upwards
   every time the list got taller. *@
<div class="auth-shell auth-shell--connect">
    <div class="theme-corner">
        <ThemeToggle />
    </div>

    <div class="auth-card auth-card--connect">
        <div class="auth-brand">
            <div class="brand-mark brand-mark-lg">
                <img src="_content/Doopass.WebUi/brand.svg" alt="" width="52" height="52" />
            </div>
        </div>

        @Body
    </div>
</div>
