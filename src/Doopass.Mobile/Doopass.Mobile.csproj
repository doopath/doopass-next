<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Doopass.Mobile</RootNamespace>
    <AssemblyName>Doopass.Mobile</AssemblyName>
    <Version>5.0.0</Version>
    <Description>Doopass Android thin client: connects to the vault host over the REST API.</Description>

    <!-- Package identity for local APK builds. -->
    <ApplicationId>io.github.doopath.doopass</ApplicationId>
    <ApplicationTitle>Doopass</ApplicationTitle>
    <ApplicationDisplayVersion>5.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- BlazorHybrid requires Android 6.0 (API 23)+; declared so the analyzer stays quiet. -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Runtime diagnostics stay readable during the first thin-client releases:
         no AOT, no trimming. Flipping this on requires a TrimmerRootDescriptor
         pass for System.Text.Json / SignalR reflection members (see docs). -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Debug builds default to Fast Deployment via the SDK defaults (imported
         before project evaluation), so a conditional override here is ignored.
         Embed the assemblies unconditionally: plain 'adb install' of a
         Fast-Deployment APK aborts at start with "No assemblies found in
         '.override'". IDE fast deployments explicitly set this back to false. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Doopass.Core\Doopass.Core.csproj" />
    <ProjectReference Include="..\Doopass.WebUi\Doopass.WebUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#4f46e5" />
  </ItemGroup>

</Project>
