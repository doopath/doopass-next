<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: the layout stretches under iOS notch / home indicator,
         and CSS env(safe-area-inset-*) offsets keep controls tappable. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f7fb" />
    <!-- Browser icon: the .ico is the legacy fallback, the SVG master is what
         current browsers pick (sharp at every DPI). Both come from assets/. -->
    <link rel="icon" href="/pwa/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/pwa/favicon.svg" />
    <base href="/" />
    <!-- PWA: installable web app (Chrome/Edge/Android, iOS 16.4+, Safari 17). -->
    <link rel="manifest" href="/pwa/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" sizes="180x180" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Doopass" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <script src="theme.js"></script>
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <!-- Custom Blazor Server reconnection dialog. blazor.web.js toggles the
         components-reconnect-* classes on this element; app.js handles the
         Reload button because the runtime never wires custom dialog buttons. -->
    <div id="components-reconnect-modal" class="app-reconnect" data-nosnippet>
        <div class="app-reconnect-card">
            <div class="app-reconnect-spinner" aria-hidden="true"></div>
            <p class="app-reconnect-title">Connection lost</p>
            <p class="app-reconnect-text app-reconnect-text-connecting">
                Reconnecting to the server<span class="app-reconnect-dots">…</span>
            </p>
            <p class="app-reconnect-text app-reconnect-text-refresh">Session interrupted. Refresh the page to reconnect.</p>
            <button type="button" class="btn btn-primary app-reconnect-reload" data-reconnect-action="reload">
                Reload
            </button>
        </div>
    </div>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss" aria-hidden="true">✕</span>
    </div>
    <script src="app.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
