@page "/"
@layout AuthLayout
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IVaultSession Session
@inject NavigationManager Nav
@inject IServiceProvider Services

<PageTitle>Doopass — Log in</PageTitle>

<h1 class="auth-title">Welcome back</h1>
<p class="auth-sub">Unlock your encrypted vault to continue.</p>

@if (_host is not null)
{
    @* Always present on thin clients, not only after a failed probe: the host
       can be replaced at any time, even while this one still answers. *@
    <div class="auth-host">
        <span class="auth-host-icon" aria-hidden="true">
            <Icon Name="database" Size="16" />
        </span>
        <span class="auth-host-main" title="@_host.Address">
            <span class="auth-host-label">Host</span>
            <span class="auth-host-url">@HostLabel(_host.Address)</span>
        </span>
        <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy"
                aria-label="Change host" @onclick="ChangeHost">
            <Icon Name="edit" Size="14" />
            <span>Change</span>
        </button>
    </div>
}

@if (_host is { IsUnreachable: true, Address: { Length: > 0 } unreachableHost })
{
    <div class="connect-alert auth-alert" role="alert">
        <Icon Name="warning" Size="16" />
        <span>
            <strong>@HostOnly(unreachableHost)</strong> did not answer. The host's address may have changed —
            pick the host again above.
        </span>
    </div>
}

<div class="auth-form" @onkeydown="HandleKeyDown">
    <input class="input" type="password" placeholder="Master password"
           disabled="@_busy"
           @bind="_password" @bind:event="oninput" autocomplete="current-password" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error">@_error</div>
    }

    <div class="auth-actions">
        <button type="button" class="btn btn-primary grow" disabled="@_busy" @onclick="LogIn">
            @if (_busy)
            {
                <span class="auth-spinner" aria-hidden="true"></span>
            }
            <span>@(_busy ? "Unlocking…" : "Unlock vault")</span>
        </button>
        <button type="button" class="btn btn-ghost" disabled="@_busy"
                @onclick="@(() => Nav.NavigateTo("/init"))">Init store</button>
    </div>
</div>

<p class="auth-foot">Your data never leaves this machine.</p>

@code {
    private string? _password;
    private string? _error;
    private IHostConnection? _host;
    private bool _busy;

    protected override void OnInitialized()
    {
        // Optional: the phone registers a host descriptor, the web host does
        // not. Resolving instead of injecting keeps one page for both hosts.
        _host = Services.GetService<IHostConnection>();

        if (_host is not null)
        {
            _host.Changed += OnHostChanged;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The login screen may render before the route guard loaded the saved
        // host; the phone's descriptor can fetch it itself.
        if (_host is not null)
        {
            await _host.EnsureLoadedAsync();
        }

        try
        {
            if ((await Session.GetStateAsync()).IsUnlocked)
            {
                Nav.NavigateTo("/store");
            }
        }
        catch (Exception ex)
        {
            // A dead host must not keep the login screen from rendering; the
            // offline banner and the host picker take over.
            AppLogger.Error("Checking the vault state on the login screen failed", ex);
        }
    }

    private static string HostOnly(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.Authority : url;

    private static string HostLabel(string? url) =>
        string.IsNullOrWhiteSpace(url) ? "not configured" : HostOnly(url);

    private void ChangeHost() => Nav.NavigateTo("/connect");

    private void OnHostChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !_busy)
        {
            _ = LogIn();
        }
    }

    private async Task LogIn()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();

        try
        {
            var (success, message) = await Session.LoginAsync(_password ?? string.Empty);

            if (success)
            {
                _password = null;
                Nav.NavigateTo("/store");
                return;
            }

            var state = await Session.GetStateAsync();

            if (state.IsOffline)
            {
                // The banner above the form explains the dead host; a password
                // error would be misleading when nothing answered at all.
                _error = null;
                return;
            }

            if (!state.StoreExists)
            {
                Nav.NavigateTo("/init");
                return;
            }

            _error = message;
        }
        catch (HostUnreachableException ex)
        {
            AppLogger.Error("Login failed: the host is unreachable", ex);
            _error = null; // the host banner offers the picker
        }
        catch (Exception ex)
        {
            AppLogger.Error("Login failed", ex);
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (_host is not null)
        {
            _host.Changed -= OnHostChanged;
        }
    }
}
