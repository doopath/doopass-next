@page "/backups"
@implements IDisposable
@inject IVaultSession Session
@inject IVaultEvents Events
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Doopass — Backups</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Backups</h1>
        <p class="page-sub">Create, restore or delete dated snapshots of your vault.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="CreateBackup">
        <Icon Name="add" Size="18" />
        <span>Create backup</span>
    </button>
</div>

@if (_names.Count > 0)
{
    <div class="card-grid">
        @foreach (var name in _names)
        {
            <div class="item-card">
                <div class="item-head">
                    <div class="item-icon">
                        <Icon Name="clock" Size="20" />
                    </div>
                    <div style="min-width:0;">
                        <div class="item-title" title="@name">@name</div>
                        <div class="muted" style="font-size:.78rem;">Encrypted snapshot</div>
                    </div>
                </div>

                <div class="item-actions">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => ConfirmRestore(name))">
                        <Icon Name="restore" Size="16" />
                        <span>Restore</span>
                    </button>
                    <span class="push"></span>
                    <button type="button" class="icon-btn" title="Delete" @onclick="@(() => ConfirmDelete(name))">
                        <Icon Name="delete" Size="18" />
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty">
        <div class="empty-icon">
            <Icon Name="clock" Size="26" />
        </div>
        <div class="empty-title">No backups yet</div>
        <div>Create a snapshot before making big changes.</div>
        <button type="button" class="btn btn-primary" @onclick="CreateBackup">
            <Icon Name="add" Size="18" />
            <span>Create backup</span>
        </button>
    </div>
}

<Modal Visible="_showRestore" Title="Restore backup?" OnClose="CancelRestore">
    <ChildContent>
        <p>
            Replace your current vault with <strong>@_restoreName</strong>?
            A safety backup of the current vault is created first.
        </p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CancelRestore">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="RestoreConfirmed">
            <Icon Name="restore" Size="18" />
            <span>Restore</span>
        </button>
    </Footer>
</Modal>

<Modal Visible="_showDelete" Title="Delete backup?" OnClose="CancelDelete">
    <ChildContent>
        <p>Delete <strong>@_deleteName</strong>? This cannot be undone.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CancelDelete">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="DeleteConfirmed">
            <Icon Name="delete" Size="18" />
            <span>Delete</span>
        </button>
    </Footer>
</Modal>

@code {
    private List<string> _names = new();

    private bool _showRestore;
    private string? _restoreName;

    private bool _showDelete;
    private string? _deleteName;

    protected override async Task OnInitializedAsync()
    {
        if (!(await Session.GetStateAsync()).IsUnlocked)
        {
            Nav.NavigateTo("/");
            return;
        }

        await RefreshAsync();
        Events.BackupsChanged += OnBackupsChanged;
        Events.VaultChanged += OnBackupsChanged;
    }

    // Restores and deletes from any client converge here; a restore also fires
    // VaultChanged, and the subscription keeps a second open page in sync too.
    private void OnBackupsChanged() => _ = InvokeAsync(RefreshAsync);

    private async Task RefreshAsync() => _names = (await Session.GetBackupNamesAsync()).ToList();

    private async Task CreateBackup()
    {
        try
        {
            await Session.CreateBackupAsync();
            await RefreshAsync();
            Toast.Success("Backup created", "A new snapshot of your vault is ready");
        }
        catch (Exception ex)
        {
            AppLogger.Error("Backup creation failed", ex);
            Toast.Error("Backup failed", ex.Message);
        }
    }

    private void ConfirmRestore(string name)
    {
        _restoreName = name;
        _showRestore = true;
    }

    private void CancelRestore()
    {
        _showRestore = false;
        _restoreName = null;
    }

    private async Task RestoreConfirmed()
    {
        if (_restoreName is null)
        {
            return;
        }

        var name = _restoreName;

        try
        {
            // The host appends the backup extension itself and re-reads the
            // store from disk after the swap (a safety backup is written first).
            await Session.RestoreBackupAsync(name);
            Toast.Success("Restored", $"Vault restored from '{name}'");
        }
        catch (Exception ex)
        {
            AppLogger.Error($"Restoring backup '{name}' failed", ex);
            Toast.Error("Restore failed", ex.Message);
        }
        finally
        {
            _showRestore = false;
            _restoreName = null;
            await RefreshAsync();
        }
    }

    private void ConfirmDelete(string name)
    {
        _deleteName = name;
        _showDelete = true;
    }

    private void CancelDelete()
    {
        _showDelete = false;
        _deleteName = null;
    }

    private async Task DeleteConfirmed()
    {
        if (_deleteName is null)
        {
            return;
        }

        var name = _deleteName;

        try
        {
            await Session.DeleteBackupAsync(name);
            Toast.Success("Backup deleted", $"'{name}' removed");
        }
        catch (Exception ex)
        {
            AppLogger.Error($"Deleting backup '{name}' failed", ex);
            Toast.Error("Delete failed", ex.Message);
        }
        finally
        {
            _showDelete = false;
            _deleteName = null;
            await RefreshAsync();
        }
    }

    public void Dispose()
    {
        Events.BackupsChanged -= OnBackupsChanged;
        Events.VaultChanged -= OnBackupsChanged;
    }
}
