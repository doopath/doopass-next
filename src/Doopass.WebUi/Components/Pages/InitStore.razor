@page "/init"
@layout AuthLayout
@inject IVaultSession Session
@inject NavigationManager Nav

<PageTitle>Doopass — Init store</PageTitle>

<h1 class="auth-title">Create your vault</h1>
<p class="auth-sub">Pick a strong master password. It encrypts everything and cannot be recovered.</p>

<div class="auth-form" @onkeydown="HandleKeyDown">
    <input class="input" type="password" placeholder="Master password"
           @bind="_password" @bind:event="oninput" autocomplete="new-password" />
    <input class="input" type="password" placeholder="Repeat password"
           @bind="_confirm" @bind:event="oninput" autocomplete="new-password" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error">@_error</div>
    }

    <div class="auth-actions">
        <button type="button" class="btn btn-primary grow" @onclick="SignUp">Create vault</button>
        <button type="button" class="btn btn-ghost" @onclick="@(() => Nav.NavigateTo("/"))">Back</button>
    </div>
</div>

<p class="auth-foot">Stored locally in ~/doopass/appdata</p>

@code {
    private string? _password;
    private string? _confirm;
    private string? _error;

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _ = SignUp();
        }
    }

    private async Task SignUp()
    {
        _error = null;

        if (!string.Equals(_password, _confirm, StringComparison.Ordinal))
        {
            _error = "Passwords do not match.";
            return;
        }

        try
        {
            var (success, message) = await Session.InitAsync(_password ?? string.Empty);

            if (success)
            {
                _password = null;
                _confirm = null;
                Nav.NavigateTo("/store");
                return;
            }

            _error = message;
        }
        catch (Exception ex)
        {
            AppLogger.Error("Vault initialization failed", ex);
            _error = $"Unexpected error: {ex.Message}";
        }
    }
}
