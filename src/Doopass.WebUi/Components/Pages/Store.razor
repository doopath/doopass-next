@page "/store"
@implements IDisposable
@inject IVaultSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>Doopass — Store</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Your vault</h1>
        <p class="page-sub">@CountText</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="BeginAdd">
        <Icon Name="add" Size="18" />
        <span>Add pair</span>
    </button>
</div>

<div class="toolbar">
    <div class="search">
        <input class="input" type="search" placeholder="Search keys..."
               value="@_filter" @oninput="OnFilterChanged"
               autocapitalize="none" autocomplete="off" enterkeyhint="search" />
    </div>
</div>

@if (FilteredKeys.Any())
{
    <div class="card-grid">
        @foreach (var key in FilteredKeys)
        {
            <div class="item-card">
                <div class="item-head">
                    <div class="item-icon">@Initial(key)</div>
                    <div class="item-title" title="@key">@key</div>
                </div>

                <div class="item-value">
                    @if (IsRevealed(key))
                    {
                        <span class="plain">@_revealedValues[key]</span>
                    }
                    else
                    {
                        <span class="secret">••••••••••</span>
                    }
                </div>

                <div class="item-actions">
                    <button type="button" class="icon-btn" title="Show / hide value" @onclick="@(() => ToggleReveal(key))">
                        <Icon Name="@(IsRevealed(key) ? "eye-off" : "eye")" Size="18" />
                    </button>
                    <button type="button" class="icon-btn" title="Copy value" @onclick="@(() => CopyAsync(key))">
                        <Icon Name="copy" Size="18" />
                    </button>
                    <span class="push"></span>
                    <button type="button" class="icon-btn" title="Edit" @onclick="@(() => BeginEdit(key))">
                        <Icon Name="edit" Size="18" />
                    </button>
                    <button type="button" class="icon-btn" title="Delete" @onclick="@(() => ConfirmDelete(key))">
                        <Icon Name="delete" Size="18" />
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty">
        <div class="empty-icon">
            <Icon Name="key" Size="26" />
        </div>
        <div class="empty-title">@(string.IsNullOrEmpty(_filter) ? "No items yet" : "Nothing found")</div>
        <div>@(string.IsNullOrEmpty(_filter) ? "Add your first key / value pair to get started." : "Try a different search term.")</div>
        @if (string.IsNullOrEmpty(_filter))
        {
            <button type="button" class="btn btn-primary" @onclick="BeginAdd">
                <Icon Name="add" Size="18" />
                <span>Add pair</span>
            </button>
        }
    </div>
}

<Modal Visible="_showEditor" Title="@(_editingKey is null ? "Add pair" : "Edit pair")" OnClose="CloseEditor">
    <ChildContent>
        <div class="field">
            <label class="field-label">Key</label>
            <input class="input" type="text" placeholder="e.g. github"
                   @bind="_formKey" @bind:event="oninput"
                   spellcheck="false" autocapitalize="none" autocomplete="off" />
        </div>
        <div class="field">
            <label class="field-label">Value</label>
            <input class="input" type="text" placeholder="Secret value"
                   @bind="_formValue" @bind:event="oninput"
                   spellcheck="false" autocapitalize="none" autocomplete="off" />
        </div>
        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="error">@_formError</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseEditor">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveForm">
            <Icon Name="check" Size="18" />
            <span>@(_editingKey is null ? "Add pair" : "Save")</span>
        </button>
    </Footer>
</Modal>

<Modal Visible="_showDelete" Title="Delete item?" OnClose="CancelDelete">
    <ChildContent>
        <p>Delete <strong>@_deleteKey</strong> from your vault? This cannot be undone.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CancelDelete">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="DeleteConfirmed">
            <Icon Name="delete" Size="18" />
            <span>Delete</span>
        </button>
    </Footer>
</Modal>

@code {
    private string? _filter;
    private CancellationTokenSource? _filterDebounce;
    private List<string> _keys = new();

    // Values are fetched lazily and cached only while a key is revealed, so a
    // secret never sits in the DOM longer than the user asked for. The same
    // pattern also keeps them off the wire on remote (API-driven) clients.
    private readonly HashSet<string> _revealed = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _revealedValues = new(StringComparer.Ordinal);

    private bool _showEditor;
    private string? _editingKey;
    private string? _formKey;
    private string? _formValue;
    private string? _formError;

    private bool _showDelete;
    private string? _deleteKey;

    private IEnumerable<string> FilteredKeys =>
        _keys
            .Where(key => string.IsNullOrEmpty(_filter) || key.Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(key => key, StringComparer.Ordinal);

    private string CountText
    {
        get
        {
            var total = _keys.Count;
            var shown = FilteredKeys.Count();

            return string.IsNullOrEmpty(_filter)
                ? $"{total} item{(total == 1 ? string.Empty : "s")}"
                : $"{shown} of {total} shown";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!(await Session.GetStateAsync()).IsUnlocked)
        {
            Nav.NavigateTo("/");
            return;
        }

        _keys = (await Session.GetKeysAsync()).ToList();
    }

    // Mobile-friendly search: every keystroke used to re-render the whole list
    // over SignalR, which on phones lagged the on-screen keyboard. Buffer the
    // typed text locally and re-render at most every 250 ms.
    private async Task OnFilterChanged(ChangeEventArgs args)
    {
        _filter = args.Value?.ToString();

        _filterDebounce?.Cancel();
        _filterDebounce?.Dispose();
        _filterDebounce = new CancellationTokenSource();
        var token = _filterDebounce.Token;

        try
        {
            await Task.Delay(250, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested)
        {
            return;
        }

        // Guarded so a late render after a navigation cannot blow up the circuit.
        if (Nav.ToBaseRelativePath(Nav.Uri).StartsWith("store", StringComparison.OrdinalIgnoreCase))
        {
            StateHasChanged();
        }
    }

    private static string Initial(string key) =>
        string.IsNullOrEmpty(key) ? "?" : key[..1].ToUpperInvariant();

    private bool IsRevealed(string key) => _revealed.Contains(key);

    private async Task ToggleReveal(string key)
    {
        if (IsRevealed(key))
        {
            _revealed.Remove(key);
            _revealedValues.Remove(key);
            return;
        }

        try
        {
            _revealedValues[key] = await Session.GetValueAsync(key);
            _revealed.Add(key);
        }
        catch (Exception ex)
        {
            AppLogger.Error($"Revealing the value of '{key}' failed", ex);
            Toast.Error("Reveal failed", ex.Message);
        }
    }

    private void BeginAdd()
    {
        _editingKey = null;
        _formKey = string.Empty;
        _formValue = string.Empty;
        _formError = null;
        _showEditor = true;
    }

    private async Task BeginEdit(string key)
    {
        _editingKey = key;
        _formKey = key;
        _showEditor = true;

        try
        {
            _formValue = await Session.GetValueAsync(key);
        }
        catch (Exception ex)
        {
            AppLogger.Error($"Loading the value of '{key}' for editing failed", ex);
            Toast.Error("Edit failed", ex.Message);
            return;
        }

        _formError = null;
    }

    private void CloseEditor()
    {
        _showEditor = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;
        var key = (_formKey ?? string.Empty).Trim();
        var value = _formValue ?? string.Empty;

        if (key.Length == 0)
        {
            _formError = "Key is required.";
            return;
        }

        try
        {
            if (_editingKey is null)
            {
                await Session.AddAsync(key, value);
                _keys.Add(key);
                Toast.Success("Added", $"'{key}' added to your vault");
            }
            else
            {
                await Session.UpdateAsync(_editingKey, key, value);
                _keys.Remove(_editingKey);
                _revealed.Remove(_editingKey);
                _revealedValues.Remove(_editingKey);
                _keys.Add(key);
                Toast.Success("Saved", $"'{key}' updated");
            }

            _showEditor = false;
        }
        catch (Exception ex) when (ex is Doopass.Core.PropertyAlreadyExistError or Doopass.Core.PropertyDoesNotExistError)
        {
            _formError = ex.Message;
        }
    }

    // The old version called navigator.clipboard.writeText directly. Android Chrome
    // gives the call no user-activation permission from the SignalR dispatch, the
    // promise rejects, and Blazor ripples the JS exception through the whole
    // circuit -- after that every button on the page stopped working. Copying now
    // runs through wwwroot/app.js, which falls back to an internal <textarea> +
    // execCommand('copy') and reports success/failure instead of throwing, so a
    // blocked clipboard shows an error toast rather than killing the session.
    private async Task CopyAsync(string key)
    {
        string value;

        try
        {
            value = await Session.GetValueAsync(key);
        }
        catch (Exception ex)
        {
            AppLogger.Error($"Reading the value of '{key}' before copy failed", ex);
            Toast.Error("Copy failed", ex.Message);
            return;
        }

        bool success;

        try
        {
            success = await JS.InvokeAsync<bool>("doopass.copyText", value);
        }
        catch (JSDisconnectedException)
        {
            // Circuit is gone; nothing left to notify.
            return;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            AppLogger.Error($"doopass.copyText failed for '{key}'", ex);
            success = false;
        }

        if (success)
        {
            Toast.Success("Copied", $"'{key}' copied to clipboard");
            return;
        }

        // Platform refused the copy (no user activation, insecure context):
        // reveal the value so it can be copied by hand instead of doing nothing.
        try
        {
            if (!_revealed.Contains(key))
            {
                _revealedValues[key] = await Session.GetValueAsync(key);
                _revealed.Add(key);
            }
        }
        catch (Exception ex)
        {
            AppLogger.Error($"Revealing the value of '{key}' before manual copy failed", ex);
        }

        Toast.Error("Clipboard is blocked", $"'{key}' value shown — copy it manually");
    }

    private void ConfirmDelete(string key)
    {
        _deleteKey = key;
        _showDelete = true;
    }

    private void CancelDelete()
    {
        _showDelete = false;
        _deleteKey = null;
    }

    private async Task DeleteConfirmed()
    {
        if (_deleteKey is null)
        {
            return;
        }

        var key = _deleteKey;

        try
        {
            await Session.RemoveAsync(key);
            _keys.Remove(key);
            _revealed.Remove(key);
            _revealedValues.Remove(key);
            _showDelete = false;
            _deleteKey = null;
            Toast.Success("Deleted", $"'{key}' removed");
        }
        catch (Exception ex)
        {
            AppLogger.Error($"Deleting '{key}' failed", ex);
            Toast.Error("Delete failed", ex.Message);
        }
    }

    public void Dispose()
    {
        _filterDebounce?.Cancel();
        _filterDebounce?.Dispose();
        _filterDebounce = null;
    }
}
