@inherits LayoutComponentBase
@implements IDisposable
@inject IVaultSession Session
@inject IVaultEvents Events
@inject NavigationManager Nav

<div class="app-shell @(_sidebarOpen ? "sidebar-open" : string.Empty)">
    <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-mark">
                <img src="_content/Doopass.WebUi/brand.svg" alt="" width="38" height="38" />
            </div>
            <div class="brand-text">
                <span class="brand-title">Doopass</span>
                <span class="brand-sub">Password Manager</span>
            </div>
        </div>

        <nav class="nav">
            <NavLink class="nav-link" href="/store" Match="NavLinkMatch.Prefix">
                <Icon Name="key" Size="18" /><span>Store</span>
            </NavLink>
            <NavLink class="nav-link" href="/backups">
                <Icon Name="history" Size="18" /><span>Backups</span>
            </NavLink>
            <NavLink class="nav-link" href="/settings">
                <Icon Name="settings" Size="18" /><span>Settings</span>
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            <button type="button" class="btn btn-ghost" @onclick="Logout">
                <Icon Name="logout" Size="18" />
                <span>Log out</span>
            </button>
            <span class="version">Doopass v@(Doopass.Core.Constants.Version)</span>
        </div>
    </aside>

    <div class="main-col">
        <header class="topbar">
            <button type="button" class="icon-btn hamburger" @onclick="ToggleSidebar" aria-label="Open navigation">
                <Icon Name="menu" Size="20" />
            </button>

            <span class="crumb">@Section</span>
            <span class="chip desktop-only">
                <Icon Name="lock" Size="13" />
                Local &amp; encrypted
            </span>

            <span class="topbar-spacer"></span>

            <ThemeToggle />
        </header>

        <main class="content">
            <div class="page">
                <ErrorBoundary>
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent>
                        <div class="card app-error-card">
                            <div class="empty-icon app-error-icon">
                                <Icon Name="warning" Size="24" />
                            </div>
                            <h2 class="page-title">Something went wrong</h2>
                            <p class="page-sub">@context.Message</p>
                            <button type="button" class="btn btn-primary" onclick="location.reload()">
                                <Icon Name="restore" Size="18" />
                                <span>Reload</span>
                            </button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </main>
    </div>
</div>

<ToastHost />

@code {
    private bool _sidebarOpen;

    private string Section => Nav.ToBaseRelativePath(Nav.Uri) switch
    {
        var path when path.StartsWith("backups", StringComparison.OrdinalIgnoreCase) => "Backups",
        var path when path.StartsWith("settings", StringComparison.OrdinalIgnoreCase) => "Settings",
        _ => "Store",
    };

    protected override void OnInitialized()
    {
        // On phones the sidebar covers the whole screen; leave it open across
        // navigation taps makes the app feel broken (people tap "Store" and
        // see nothing happen). Close on every in-app navigation.
        Nav.LocationChanged += OnLocationChanged;

        // Any lock (logout elsewhere, session TTL, host relock) returns to login.
        Events.VaultLocked += OnVaultLocked;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_sidebarOpen)
        {
            _sidebarOpen = false;
            StateHasChanged();
        }
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void CloseSidebar() => _sidebarOpen = false;

    private Task OnVaultLocked() => InvokeAsync(() => Nav.NavigateTo("/"));

    private async Task Logout()
    {
        await Session.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Events.VaultLocked -= OnVaultLocked;
    }
}
