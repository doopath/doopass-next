<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Doopass.WebUi</RootNamespace>
    <AssemblyName>Doopass.WebUi</AssemblyName>
    <Version>5.0.0</Version>
    <Description>Doopass web UI: Razor components, themes and the vault session contract shared by the server host and mobile thin clients.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Razor components compile against the NuGet packages so the same RCL
         runs in the web host (shared framework) and MAUI WebView hosts,
         which have no Microsoft.AspNetCore.App runtime pack on mobile. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static assets: embedded resources back the server host's direct serving
         (single-file publish), while the default content items make the same
         files available under _content/Doopass.WebUi/ in the MAUI WebView.
         Both flows read the identical sources; no duplication on disk. -->
    <EmbeddedResource Include="wwwroot\app.css" LogicalName="Doopass.WebUi.wwwroot.app.css" />
    <EmbeddedResource Include="wwwroot\theme.js" LogicalName="Doopass.WebUi.wwwroot.theme.js" />
    <EmbeddedResource Include="wwwroot\app.js" LogicalName="Doopass.WebUi.wwwroot.app.js" />
    <!-- Brand mark for the sidebar and the auth card; a copy of the vector
         master, written by scripts\generate-icons.py. -->
    <EmbeddedResource Include="wwwroot\brand.svg" LogicalName="Doopass.WebUi.wwwroot.brand.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Doopass.Core\Doopass.Core.csproj" />
  </ItemGroup>

</Project>
