<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Doopass.WebUi</RootNamespace>
    <AssemblyName>Doopass.WebUi</AssemblyName>
    <Version>5.0.0</Version>
    <Description>Doopass web UI: Razor components, themes and the vault session contract shared by the server host and mobile thin clients.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Razor components depend on the ASP.NET Core shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static assets are served from embedded resources so the app can be published,
         self-contained, as a single file with no wwwroot folder next to it. The same
         assets back the MAUI Blazor WebView host, which reads them from this assembly. -->
    <EmbeddedResource Include="wwwroot\app.css" LogicalName="Doopass.WebUi.wwwroot.app.css" />
    <EmbeddedResource Include="wwwroot\theme.js" LogicalName="Doopass.WebUi.wwwroot.theme.js" />
    <EmbeddedResource Include="wwwroot\app.js" LogicalName="Doopass.WebUi.wwwroot.app.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't publish wwwroot as loose files; assets are embedded and served from resources. -->
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Doopass.Core\Doopass.Core.csproj" />
  </ItemGroup>

</Project>
